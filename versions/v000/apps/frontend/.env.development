# 🟡 DESARROLLO - dev.dafel.com.mx
# Configuración para ambiente de desarrollo v0.2.0

# Environment
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Application
NEXT_PUBLIC_APP_NAME=Dafel Technologies (Development)
NEXT_PUBLIC_APP_URL=https://dev.dafel.com.mx
NEXT_PUBLIC_SITE_URL=https://dev.dafel.com.mx

# API Configuration
NEXT_PUBLIC_API_URL=https://dev-api.dafel.com.mx
NEXT_PUBLIC_API_TIMEOUT=30000

# Analytics - Development (disabled or test IDs)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Features Flags - Development
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_NEWSLETTER=false

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=dev-contacto@dafel.com.mx
NEXT_PUBLIC_SUPPORT_EMAIL=dev-soporte@dafel.com.mx
NEXT_PUBLIC_SALES_EMAIL=dev-ventas@dafel.com.mx

# Social Media (same as production)
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/dafel-technologies
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/dafel_tech
NEXT_PUBLIC_GITHUB_URL=https://github.com/dafel-technologies

# Security - Development
NEXTAUTH_URL=https://dev.dafel.com.mx
NEXTAUTH_SECRET=dev_secret_key_for_development_only
ENCRYPTION_MASTER_KEY=VGhpc0lzQURldmVsb3BtZW50S2V5Rm9yMzJieXRlcyEh

# Database - Development (TO BE CONFIGURED)
# DATABASE_URL="postgresql://dev_user:dev_password@dev-db-host:5432/dafel_development"

# Redis Cache - Development (TO BE CONFIGURED)
# REDIS_URL="redis://dev-redis:6379"

# Email Service - Development (TO BE CONFIGURED)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Cloud Storage - Development (TO BE CONFIGURED)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=
# AWS_REGION=

# Performance
NEXT_TELEMETRY_DISABLED=true

# SEO - Development
NEXT_PUBLIC_ROBOTS=noindex,nofollow
NEXT_PUBLIC_CANONICAL_URL=https://dev.dafel.com.mx

# Development flags
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_SHOW_DEBUG_PANEL=true
ENABLE_SOURCEMAPS=true