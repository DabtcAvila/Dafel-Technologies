{% comment %}
  Default Dafel Banda SVG - Optimized for Shopify
  This is the main SVG template with default blue color scheme
{% endcomment %}

{% liquid
  assign animation_class = 'animate-' | append: animation | default: 'fadeIn'
  assign unique_id = 'dafel-banda-' | append: section.id | default: 'default'
%}

<svg 
  width="100%" 
  height="auto" 
  viewBox="0 0 1280 720" 
  xmlns="http://www.w3.org/2000/svg"
  class="dafel-banda-svg {{ animation_class }}"
  id="{{ unique_id }}"
  data-animation="{{ animation }}"
  role="img"
  aria-label="Dafel Banda decorative background"
>
  <defs>
    <!-- Gradients with unique IDs for this instance -->
    <radialGradient id="{{ unique_id }}-grad-blue-light-radial" cx="30%" cy="40%">
      <stop offset="0%" stop-color="#D0E8F5" class="color-stop-start"/>
      <stop offset="50%" stop-color="#A8D1E6" class="color-stop-mid"/>
      <stop offset="100%" stop-color="#7DBBDB" class="color-stop-end"/>
    </radialGradient>

    <linearGradient id="{{ unique_id }}-grad-blue-light-linear" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#C0DFF0" class="color-stop-start"/>
      <stop offset="100%" stop-color="#6FB3D9" class="color-stop-end"/>
    </linearGradient>

    <radialGradient id="{{ unique_id }}-grad-green-lime" cx="35%" cy="45%">
      <stop offset="0%" stop-color="#D5EDB8" class="color-stop-start"/>
      <stop offset="50%" stop-color="#AAD989" class="color-stop-mid"/>
      <stop offset="100%" stop-color="#7BC77F" class="color-stop-end"/>
    </radialGradient>

    <linearGradient id="{{ unique_id }}-grad-teal" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#5FD4C4" class="color-stop-start"/>
      <stop offset="50%" stop-color="#3AAFA3" class="color-stop-mid"/>
      <stop offset="100%" stop-color="#1B8F9A" class="color-stop-end"/>
    </linearGradient>

    <linearGradient id="{{ unique_id }}-grad-blue-medium" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#5AAED0" class="color-stop-start"/>
      <stop offset="50%" stop-color="#3493B8" class="color-stop-mid"/>
      <stop offset="100%" stop-color="#1E7FA4" class="color-stop-end"/>
    </linearGradient>

    <linearGradient id="{{ unique_id }}-grad-blue-dark" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2B88AA" class="color-stop-start"/>
      <stop offset="50%" stop-color="#1A6983" class="color-stop-mid"/>
      <stop offset="100%" stop-color="#0E5F7E" class="color-stop-end"/>
    </linearGradient>

    <linearGradient id="{{ unique_id }}-grad-blue-deepest" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1B7696" class="color-stop-start"/>
      <stop offset="50%" stop-color="#115A75" class="color-stop-mid"/>
      <stop offset="100%" stop-color="#094A62" class="color-stop-end"/>
    </linearGradient>

    <!-- Grid Patterns -->
    <pattern id="{{ unique_id }}-grid-teal" patternUnits="userSpaceOnUse" width="18" height="18">
      <rect width="18" height="18" fill="none"/>
      <path d="M18 0L0 0 0 18" fill="none" stroke="#5FD4C4" stroke-width="1.5" opacity="0.25"/>
    </pattern>

    <pattern id="{{ unique_id }}-grid-blue-medium" patternUnits="userSpaceOnUse" width="16" height="16">
      <rect width="16" height="16" fill="none"/>
      <path d="M16 0L0 0 0 16" fill="none" stroke="#3493B8" stroke-width="1.8" opacity="0.30"/>
    </pattern>

    <pattern id="{{ unique_id }}-grid-blue-dark" patternUnits="userSpaceOnUse" width="14" height="14">
      <rect width="14" height="14" fill="none"/>
      <path d="M14 0L0 0 0 14" fill="none" stroke="#1A6983" stroke-width="2" opacity="0.32"/>
    </pattern>

    <!-- Animation definitions -->
    <style>
      .animate-fadeIn { animation: dafelFadeIn 2s ease-out; }
      .animate-wave { animation: dafelWave 4s ease-in-out infinite; }
      .animate-pulse { animation: dafelPulse 3s ease-in-out infinite; }
      .animate-staggerIn .band-layer { animation: dafelStaggerIn 1.5s ease-out both; }
      .animate-interactive:hover .band-layer { animation: dafelHover 0.8s ease-out; }
      
      @keyframes dafelFadeIn {
        0% { opacity: 0; transform: translateY(30px) scale(0.95); }
        100% { opacity: 1; transform: translateY(0) scale(1); }
      }
      
      @keyframes dafelWave {
        0%, 100% { transform: translateX(0) scaleX(1); }
        25% { transform: translateX(5px) scaleX(1.01); }
        75% { transform: translateX(-5px) scaleX(0.99); }
      }
      
      @keyframes dafelPulse {
        0%, 100% { opacity: 0.8; }
        50% { opacity: 1; }
      }
      
      @keyframes dafelStaggerIn {
        0% { opacity: 0; transform: translateY(20px); }
        100% { opacity: 1; transform: translateY(0); }
      }
      
      @keyframes dafelHover {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.02); }
      }
    </style>
  </defs>

  <!-- Layer 1: Blue Light Back (Radial gradient, no grid) -->
  <g class="band-layer layer-1" 
     data-layer="blue-light-back" 
     opacity="0.45"
     style="animation-delay: 0.1s;">
    <path d="M0,180 C213.33,120 426.67,240 640,180 C853.33,120 1066.67,240 1280,180 L1280,360 C1066.67,420 853.33,300 640,360 C426.67,420 213.33,300 0,360 Z" 
          fill="url(#{{ unique_id }}-grad-blue-light-radial)" 
          class="band-curved"/>
  </g>

  <!-- Layer 2: Blue Light Front (Linear gradient, no grid) -->
  <g class="band-layer layer-2" 
     data-layer="blue-light-front" 
     opacity="0.55"
     style="animation-delay: 0.2s;">
    <path d="M0,220 C213.33,160 426.67,280 640,220 C853.33,160 1066.67,280 1280,220 L1280,400 C1066.67,460 853.33,340 640,400 C426.67,460 213.33,340 0,400 Z" 
          fill="url(#{{ unique_id }}-grad-blue-light-linear)" 
          class="band-curved"/>
  </g>

  <!-- Layer 3: Green Lime (Radial gradient, no grid) -->
  <g class="band-layer layer-3" 
     data-layer="green-lime" 
     opacity="0.38"
     style="animation-delay: 0.3s;">
    <path d="M0,260 C213.33,200 426.67,320 640,260 C853.33,200 1066.67,320 1280,260 L1280,440 C1066.67,500 853.33,380 640,440 C426.67,500 213.33,380 0,440 Z" 
          fill="url(#{{ unique_id }}-grad-green-lime)" 
          class="band-curved"/>
  </g>

  <!-- Layer 4: Teal (Linear gradient, with grid) -->
  <g class="band-layer layer-4" 
     data-layer="teal-grid" 
     opacity="0.65"
     style="animation-delay: 0.4s;">
    <path d="M0,300 C213.33,240 426.67,360 640,300 C853.33,240 1066.67,360 1280,300 L1280,480 C1066.67,540 853.33,420 640,480 C426.67,540 213.33,420 0,480 Z" 
          fill="url(#{{ unique_id }}-grad-teal)" 
          class="band-curved band-with-grid"/>
    <path d="M0,300 C213.33,240 426.67,360 640,300 C853.33,240 1066.67,360 1280,300 L1280,480 C1066.67,540 853.33,420 640,480 C426.67,540 213.33,420 0,480 Z" 
          fill="url(#{{ unique_id }}-grid-teal)" 
          class="band-curved band-grid-overlay"/>
  </g>

  <!-- Layer 5: Blue Medium (Linear gradient, with grid) -->
  <g class="band-layer layer-5" 
     data-layer="blue-medium-grid" 
     opacity="0.70"
     style="animation-delay: 0.5s;">
    <path d="M0,340 C213.33,280 426.67,400 640,340 C853.33,280 1066.67,400 1280,340 L1280,520 C1066.67,580 853.33,460 640,520 C426.67,580 213.33,460 0,520 Z" 
          fill="url(#{{ unique_id }}-grad-blue-medium)" 
          class="band-curved band-with-grid"/>
    <path d="M0,340 C213.33,280 426.67,400 640,340 C853.33,280 1066.67,400 1280,340 L1280,520 C1066.67,580 853.33,460 640,520 C426.67,580 213.33,460 0,520 Z" 
          fill="url(#{{ unique_id }}-grid-blue-medium)" 
          class="band-curved band-grid-overlay"/>
  </g>

  <!-- Layer 6: Blue Dark (Linear gradient, with grid) -->
  <g class="band-layer layer-6" 
     data-layer="blue-dark-grid" 
     opacity="0.75"
     style="animation-delay: 0.6s;">
    <path d="M0,380 C213.33,320 426.67,440 640,380 C853.33,320 1066.67,440 1280,380 L1280,560 C1066.67,620 853.33,500 640,560 C426.67,620 213.33,500 0,560 Z" 
          fill="url(#{{ unique_id }}-grad-blue-dark)" 
          class="band-curved band-with-grid"/>
    <path d="M0,380 C213.33,320 426.67,440 640,380 C853.33,320 1066.67,440 1280,380 L1280,560 C1066.67,620 853.33,500 640,560 C426.67,620 213.33,500 0,560 Z" 
          fill="url(#{{ unique_id }}-grid-blue-dark)" 
          class="band-curved band-grid-overlay"/>
  </g>

  <!-- Layer 7: Blue Deepest (Linear gradient, no grid) -->
  <g class="band-layer layer-7" 
     data-layer="blue-deepest" 
     opacity="0.82"
     style="animation-delay: 0.7s;">
    <path d="M0,420 C213.33,360 426.67,480 640,420 C853.33,360 1066.67,480 1280,420 L1280,600 C1066.67,660 853.33,540 640,600 C426.67,660 213.33,540 0,600 Z" 
          fill="url(#{{ unique_id }}-grad-blue-deepest)" 
          class="band-curved"/>
  </g>
</svg>

{% comment %} Add Shopify-specific interaction tracking {% endcomment %}
{% if section.settings.analytics_tracking %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const bandaElement = document.getElementById('{{ unique_id }}');
    if (bandaElement && typeof shopifyAnalytics !== 'undefined') {
      // Track when animation becomes visible
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            shopifyAnalytics.lib.track('Dafel Banda Animation Viewed', {
              animation: '{{ animation }}',
              section: '{{ section.type }}',
              page: '{{ request.page_type }}'
            });
            observer.unobserve(entry.target);
          }
        });
      });
      observer.observe(bandaElement);
      
      // Track hover interactions if interactive
      {% if section.settings.interactive_hover %}
      bandaElement.addEventListener('mouseenter', function() {
        shopifyAnalytics.lib.track('Dafel Banda Animation Hovered', {
          animation: '{{ animation }}',
          section: '{{ section.type }}'
        });
      });
      {% endif %}
    }
  });
</script>
{% endif %}