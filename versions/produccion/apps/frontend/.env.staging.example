# 🔵 STAGING - staging.dafel.com.mx  
# Configuración para ambiente de staging (pre-producción)

# Environment
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=staging

# Application URLs
NEXTAUTH_URL=https://staging.dafel.com.mx
NEXT_PUBLIC_SITE_URL=https://staging.dafel.com.mx

# Database - Staging (réplica de producción)
DATABASE_URL="postgresql://dafel_staging_user:staging_password@staging.db.dafel.com.mx:5432/dafel_staging"

# NextAuth Secret (único para staging)
NEXTAUTH_SECRET="staging_secret_key_secure_and_unique"

# API Keys (staging/testing)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# External Services (staging/sandbox)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# CDN/Storage (staging)
AWS_S3_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""

# Monitoring (staging)
NEXT_PUBLIC_HOTJAR_ID=""
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""

# Staging flags
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_SHOW_DEBUG_PANEL=true
ENABLE_SOURCEMAPS=false
NEXT_PUBLIC_STAGING_BANNER=true