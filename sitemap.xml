---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9
        http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">
    
    <!-- Homepage -->
    <url>
        <loc>{{ site.url }}/</loc>
        <lastmod>2024-01-03T00:00:00Z</lastmod>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
    </url>
    
    <!-- Installation Guide -->
    <url>
        <loc>{{ site.url }}/docs/installation/</loc>
        <lastmod>2024-01-03T00:00:00Z</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.9</priority>
    </url>
    
    <!-- Features Documentation -->
    <url>
        <loc>{{ site.url }}/docs/features/</loc>
        <lastmod>2024-01-03T00:00:00Z</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.9</priority>
    </url>
    
    <!-- API Reference -->
    <url>
        <loc>{{ site.url }}/docs/api/</loc>
        <lastmod>2024-01-03T00:00:00Z</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
    </url>
    
    <!-- Architecture Documentation -->
    <url>
        <loc>{{ site.url }}/docs/architecture/</loc>
        <lastmod>2024-01-03T00:00:00Z</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
    </url>
    
    <!-- Generate URLs for all pages in docs collection -->
    {% for doc in site.docs %}
    <url>
        <loc>{{ site.url }}{{ doc.url }}</loc>
        <lastmod>{{ doc.date | default: site.time | date_to_xmlschema }}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.6</priority>
    </url>
    {% endfor %}
    
    <!-- Generate URLs for all regular pages -->
    {% for page in site.pages %}
        {% unless page.url contains '/404' or page.url contains '/admin' or page.url contains '/test' %}
        <url>
            <loc>{{ site.url }}{{ page.url | remove: 'index.html' }}</loc>
            <lastmod>{{ page.date | default: site.time | date_to_xmlschema }}</lastmod>
            <changefreq>weekly</changefreq>
            <priority>0.5</priority>
        </url>
        {% endunless %}
    {% endfor %}
    
</urlset>