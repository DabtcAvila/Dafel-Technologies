    },
    {
      "name": "Interactive Element",
      "settings": {
        "animation_type": "interactive",
        "size": "medium",
        "interactive_hover": true,
        "color_scheme": "default"
      }
    },
    {
      "name": "Loading Animation",
      "settings": {
        "animation_type": "staggerIn",
        "size": "small",
        "animation_speed": 1.5,
        "animation_loop": false
      }
    }
  ]
}
{% endschema %}