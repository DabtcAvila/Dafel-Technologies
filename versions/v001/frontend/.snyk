# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.0

# Language-specific settings
language-settings:
  javascript:
    # Ignore dev dependencies by default
    ignoreDev: false
    # Set the severity threshold
    severityThreshold: high

# Patch settings
patch: {}

# Ignore settings
ignore:
  # Example: Ignore a specific vulnerability in a specific package
  # SNYK-JS-LODASH-567746:
  #   - lodash:
  #       reason: 'No fix available and low impact on our use case'
  #       expires: '2024-12-31T23:59:59.999Z'

# Package manager specific settings
packageManager: npm

# Vulnerability database settings
version: v1.25.0