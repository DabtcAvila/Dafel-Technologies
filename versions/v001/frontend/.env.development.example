# 🟡 DESARROLLO - dev.dafel.com.mx
# Configuración para ambiente de desarrollo

# Environment
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Application URLs
NEXTAUTH_URL=https://dev.dafel.com.mx
NEXT_PUBLIC_SITE_URL=https://dev.dafel.com.mx

# Database - Development
DATABASE_URL="postgresql://dafel_dev_user:dev_password@dev.db.dafel.com.mx:5432/dafel_dev"

# NextAuth Secret (generar nuevo para cada ambiente)
NEXTAUTH_SECRET="dev_secret_key_change_this_in_production"

# API Keys (development)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# External Services (development/sandbox)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# CDN/Storage (development)
AWS_S3_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""

# Monitoring (development)
NEXT_PUBLIC_HOTJAR_ID=""
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""

# Development flags
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_SHOW_DEBUG_PANEL=true
ENABLE_SOURCEMAPS=true