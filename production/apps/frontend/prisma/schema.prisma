generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String  @id @default(cuid())
  email       String  @unique
  password    String
  role        Role    @default(CLIENT)
  companyName String?
  groupName   String?
  isActive    Boolean @default(true)
  year2016    Boolean @default(false)
  year2017    Boolean @default(false)
  year2018    Boolean @default(false)
  year2019    Boolean @default(false)
  year2020    Boolean @default(false)
  year2021    Boolean @default(false)
  year2022    Boolean @default(false)
  year2023    Boolean @default(false)
  year2024    Boolean @default(false)
  year2025    Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
}

enum Role {
  ADMIN
  CLIENT
  GROUP
}
