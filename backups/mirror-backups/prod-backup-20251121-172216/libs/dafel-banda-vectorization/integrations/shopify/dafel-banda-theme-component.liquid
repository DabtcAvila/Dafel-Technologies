        "animation_type": "wave",
        "size": "full",
        "color_scheme": "default",
        "animation_speed": 4,
        "animation_loop": true
      }
    },
    {
      "name": "Section Divider",
      "settings": {
        "animation_type": "pulse",
        "size": "large",
        "color_scheme": "brand",
        "margin_top": 40,
        "margin_bottom": 40
