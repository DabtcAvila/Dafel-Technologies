{
  "name": "@dafel/banda-svelte",
  "version": "1.0.0",
  "description": "Dafel Banda SVG component library for Svelte/SvelteKit",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "svelte-kit sync && svelte-package",
    "dev": "vite dev",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint src --ext .ts,.svelte",
    "type-check": "svelte-check"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "svg",
    "animation",
    "component",
    "dafel",
    "banda"
  ],
  "author": "Dafel Technologies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dafel-technologies/banda-components"
  },
  "peerDependencies": {
    "svelte": ">=4.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^2.1.0",
    "@sveltejs/kit": "^1.20.0",
    "@sveltejs/package": "^2.2.0",
    "eslint": "^8.45.0",
    "eslint-plugin-svelte": "^2.32.0",
    "svelte": "^4.2.0",
    "svelte-check": "^3.4.0",
    "typescript": "^5.1.0",
    "vite": "^4.4.0",
    "vitest": "^0.34.0"
  }
}