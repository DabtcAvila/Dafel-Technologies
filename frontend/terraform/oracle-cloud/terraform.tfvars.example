# Oracle Cloud Terraform Variables Template
# Copy this file to terraform.tfvars and fill with your actual values

# Oracle Cloud Infrastructure Authentication
tenancy_ocid     = "ocid1.tenancy.oc1..your-tenancy-ocid-here"
user_ocid        = "ocid1.user.oc1..your-user-ocid-here"  
fingerprint      = "your-api-key-fingerprint-here"
private_key_path = "/path/to/your/oci_api_key.pem"

# Deployment Configuration
region           = "us-ashburn-1"  # Free tier available regions: us-ashburn-1, us-phoenix-1, eu-frankfurt-1
compartment_ocid = "ocid1.compartment.oc1..your-compartment-ocid-here"

# SSH Key for server access (paste your public key content)
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQ... your-ssh-public-key-here"