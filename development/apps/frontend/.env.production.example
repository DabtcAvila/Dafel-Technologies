# Production Environment Template for dafel.com.mx
# Copy this file to .env.production and fill in the actual values

# Application
NEXT_PUBLIC_APP_NAME=Dafel Technologies
NEXT_PUBLIC_APP_URL=https://dafel.com.mx
NEXT_PUBLIC_SITE_URL=https://dafel.com.mx

# API Configuration
NEXT_PUBLIC_API_URL=https://api.dafel.com.mx
NEXT_PUBLIC_API_TIMEOUT=30000

# Database - Configure with your production database
DATABASE_URL="postgresql://dafel_prod_user:CHANGE_THIS_PASSWORD@postgres:5432/dafel_production"
DB_PASSWORD="CHANGE_THIS_STRONG_PASSWORD"

# Authentication
NEXTAUTH_URL=https://dafel.com.mx
NEXTAUTH_SECRET="CHANGE_THIS_TO_RANDOM_STRING_64_CHARS_LONG"

# Redis
REDIS_URL="redis://:REDIS_PASSWORD@redis:6379"
REDIS_PASSWORD="CHANGE_THIS_REDIS_PASSWORD"

# Email Service (Configure with your SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Cloud Storage (AWS S3)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_BUCKET_NAME=dafel-uploads
AWS_REGION=us-east-1

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Monitoring
GRAFANA_PASSWORD="CHANGE_THIS_GRAFANA_PASSWORD"

# Features - Production settings
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_NEWSLETTER=true

# Contact
NEXT_PUBLIC_CONTACT_EMAIL=contacto@dafel.com.mx
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@dafel.com.mx
NEXT_PUBLIC_SALES_EMAIL=ventas@dafel.com.mx

# Social Media
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/dafel-technologies
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/dafel_tech
NEXT_PUBLIC_GITHUB_URL=https://github.com/dafel-technologies

# Environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=false