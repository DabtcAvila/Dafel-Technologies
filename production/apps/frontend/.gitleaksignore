# GitLeaks ignore patterns
# Format: <rule>:<file>:<commit>

# Ignore test files with mock secrets
generic-api-key:src/**/*.test.*:*
generic-api-key:cypress/**/*:*
generic-api-key:__tests__/**/*:*

# Ignore example/template files
*:.env.example:*
*:.env.template:*
*:example.env:*

# Ignore documentation
*:*.md:*
*:docs/**/*:*

# Ignore configuration files that might contain example keys
generic-api-key:next.config.js:*
generic-api-key:tailwind.config.ts:*

# Ignore specific known false positives
# Format: rule:file:commit_hash (use * for all commits)
# Example:
# generic-api-key:src/lib/config.ts:abc123def