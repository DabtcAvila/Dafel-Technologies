{
  "name": "dafel-technologies-frontend",
  "version": "0.2.0",
  "private": true,
  "description": "Dafel Technologies - Enterprise Data Platform with AI Solutions",
  "author": "Dafel Technologies",
  "repository": {
    "type": "git",
    "url": "https://github.com/DabtcAvila/Dafel-Technologies.git"
  },
  "homepage": "https://dafel.com.mx",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:dev": "NODE_ENV=development NEXT_PUBLIC_APP_ENV=development next dev -p 3000",
    "dev:staging": "NODE_ENV=production NEXT_PUBLIC_APP_ENV=staging next dev -p 3000",
    "build": "next build",
    "build:dev": "NODE_ENV=development NEXT_PUBLIC_APP_ENV=development next build",
    "build:staging": "NODE_ENV=production NEXT_PUBLIC_APP_ENV=staging next build",
    "build:production": "NODE_ENV=production NEXT_PUBLIC_APP_ENV=production next build",
    "start": "next start",
    "start:dev": "NODE_ENV=development NEXT_PUBLIC_APP_ENV=development next start",
    "start:staging": "NODE_ENV=production NEXT_PUBLIC_APP_ENV=staging next start",
    "start:production": "NODE_ENV=production NEXT_PUBLIC_APP_ENV=production next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "analyze": "ANALYZE=true next build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:security": "npm run test:security:zap && npm run test:security:audit",
    "test:security:zap": "node tests/security/zap-security-test.js",
    "test:security:audit": "npm audit --audit-level moderate",
    "test:performance": "k6 run tests/performance/load-test.js",
    "test:performance:stress": "k6 run tests/performance/stress-test.js",
    "test:performance:spike": "k6 run tests/performance/spike-test.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:security && npm run test:performance",
    "lighthouse": "npx lhci autorun",
    "audit": "npm run build && npm run lighthouse",
    "build:cdn": "node scripts/build-cdn.js",
    "deploy:cdn": "npm run build:cdn && echo 'Ready for CDN deployment!'",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma migrate dev && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@aws-sdk/client-s3": "^3.879.0",
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^6.15.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@sinclair/typebox": "^0.34.41",
    "@types/pg": "^8.15.5",
    "@vercel/analytics": "^1.3.1",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "bullmq": "^5.58.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.18.2",
    "ioredis": "^5.7.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.545.0",
    "mongodb": "^6.19.0",
    "mysql2": "^3.14.4",
    "next": "^14.2.32",
    "next-auth": "^4.24.11",
    "next-intl": "^4.3.5",
    "node-fetch": "^2.7.0",
    "p-limit": "^7.1.1",
    "p-queue": "^8.1.0",
    "p-retry": "^7.0.0",
    "pg": "^8.16.3",
    "pg-query-stream": "^4.10.3",
    "prisma": "^6.15.0",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.2.1",
    "react-intersection-observer": "^9.10.3",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "sharp": "^0.33.4",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@emotion/jest": "^11.13.0",
    "@lhci/cli": "^0.12.0",
    "@next/bundle-analyzer": "^14.2.5",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.19",
    "babel-jest": "^30.1.2",
    "critters": "^0.0.23",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "jest-html-reporters": "^3.1.7",
    "msw": "^2.11.3",
    "postcss": "^8.4.40",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.20.5",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
